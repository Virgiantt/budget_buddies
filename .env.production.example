# Template konfigurasi produksi.
#
# Salin ke .env di folder yang sama dengan compose.yml:
#     cp .env.production.example .env
#     chmod 600 .env
#
# File .env TIDAK ikut Git dan TIDAK ikut image Docker.

APP_NAME="Budget Buddies"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://127.0.0.1:44000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
BCRYPT_ROUNDS=12

LOG_CHANNEL=stderr
LOG_LEVEL=error

# SQLite. Path ini berada di dalam volume app-storage, jadi ikut persisten.
DB_CONNECTION=sqlite
DB_DATABASE=/var/www/html/storage/database/database.sqlite
DB_FOREIGN_KEYS=true
# 5 detik tunggu kalau file sedang dikunci proses lain (queue/scheduler/web).
DB_BUSY_TIMEOUT=5000
DB_JOURNAL_MODE=WAL

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Set true kalau sudah diakses lewat HTTPS (domain + reverse proxy).
SESSION_SECURE_COOKIE=false

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="Budget Buddies"

# Port yang dipublikasikan compose.yml (hanya di 127.0.0.1).
APP_PORT=44000
